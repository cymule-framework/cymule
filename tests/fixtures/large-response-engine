#!/usr/bin/python3
import json
import sys

request = json.load(sys.stdin)["request"]
candidate = dict(request["candidate"])
candidate["metadata"] = {"large": "x" * 262144}
json.dump(
    {
        "engine_protocol": "cymule.engine/5",
        "outcome": "success",
        "request": request,
        "response": {
            "type": "sealed",
            "plan": {"plan_id": "sha256:" + "0" * 64, "candidate": candidate},
        },
    },
    sys.stdout,
    separators=(",", ":"),
)
