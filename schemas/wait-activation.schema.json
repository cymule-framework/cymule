{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cymule.dev/schemas/wait-activation.schema.json",
  "title": "Cymule Wait Activation cymule.wait-activation/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["activation_version", "activation_id", "source", "wait_ids", "result"],
  "properties": {
    "activation_version": { "const": "cymule.wait-activation/1" },
    "activation_id": { "type": "string", "minLength": 1 },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "key"],
          "properties": {
            "kind": { "const": "signal" },
            "key": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "timer_id"],
          "properties": {
            "kind": { "const": "timer" },
            "timer_id": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "wait_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "kind"],
      "properties": {
        "artifact_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "kind": { "type": "string", "minLength": 1 }
      }
    }
  }
}
