{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cymule.dev/schemas/wait-activation.schema.json",
  "title": "Cymule Wait Activation cymule.wait-activation/2",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "contentId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": ["activation_version", "activation_id", "source", "wait_ids", "result"],
  "properties": {
    "activation_version": { "const": "cymule.wait-activation/2" },
    "activation_id": { "$ref": "#/$defs/identity" },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "key"],
          "properties": {
            "kind": { "const": "signal" },
            "key": { "$ref": "#/$defs/identity" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "timer_id"],
          "properties": {
            "kind": { "const": "timer" },
            "timer_id": { "$ref": "#/$defs/identity" }
          }
        }
      ]
    },
    "wait_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/contentId" }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_version", "artifact_id", "kind"],
      "properties": {
        "identity_version": { "const": "cymule.artifact/2" },
        "artifact_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "kind": { "const": "cymule.wait-result/1" }
      }
    }
  }
}
