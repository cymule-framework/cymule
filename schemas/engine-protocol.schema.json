{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cymule.dev/schemas/engine-protocol.schema.json",
  "title": "Cymule Engine Request",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false, "required": ["type", "candidate"],
      "properties": { "type": { "const": "seal" }, "candidate": { "$ref": "plan-candidate.schema.json" } }
    },
    {
      "type": "object", "additionalProperties": false, "required": ["type", "plan"],
      "properties": { "type": { "const": "verify" }, "plan": { "$ref": "sealed-plan.schema.json" } }
    },
    {
      "type": "object", "additionalProperties": false, "required": ["type", "candidate"],
      "properties": {
        "type": { "const": "seal_resource" },
        "candidate": { "$ref": "resource.schema.json#/$defs/resourceCandidate" }
      }
    },
    {
      "type": "object", "additionalProperties": false, "required": ["type", "activation"],
      "properties": {
        "type": { "const": "verify_wait_activation" },
        "activation": { "$ref": "wait-activation.schema.json" }
      }
    },
    {
      "type": "object", "additionalProperties": false, "required": ["type", "command"],
      "properties": {
        "type": { "const": "verify_durable_command" },
        "command": { "$ref": "durable-control.schema.json" }
      }
    },
    {
      "type": "object", "additionalProperties": false, "required": ["type", "command"],
      "properties": {
        "type": { "const": "verify_evolution_command" },
        "command": { "$ref": "evolution-control.schema.json" }
      }
    },
    {
      "type": "object", "additionalProperties": false, "required": ["type", "command"],
      "properties": {
        "type": { "const": "verify_live_evolution_command" },
        "command": { "$ref": "live-evolution-control.schema.json" }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["type", "plan", "input", "plugin", "run_id"],
      "properties": {
        "type": { "const": "run" }, "plan": { "$ref": "sealed-plan.schema.json" },
        "input": true, "plugin": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    }
  ]
}
