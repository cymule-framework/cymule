{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cymule.dev/schemas/execution-binding.schema.json",
  "title": "Cymule Execution Binding cymule.execution-binding/2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "context", "components", "effects"],
  "properties": {
    "version": {"const": "cymule.execution-binding/2"},
    "context": {"$ref": "#/$defs/context"},
    "components": {"type": "object", "maxProperties": 128, "propertyNames": {"$ref": "#/$defs/token"}, "additionalProperties": {"$ref": "#/$defs/componentBinding"}},
    "effects": {"type": "object", "maxProperties": 128, "propertyNames": {"$ref": "#/$defs/token"}, "additionalProperties": {"$ref": "#/$defs/effectBinding"}}
  },
  "$defs": {
    "token": {
      "type": "string", "minLength": 1, "maxLength": 256,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "name", "api_revision"],
      "properties": {
        "namespace": {"$ref": "#/$defs/token"},
        "name": {"$ref": "#/$defs/token"},
        "api_revision": {"$ref": "#/$defs/token"}
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation_id", "revision"],
      "properties": {
        "implementation_id": {"$ref": "#/$defs/token"},
        "revision": {"$ref": "#/$defs/token"}
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "provider_id", "implementation", "provides", "requires", "properties", "configuration_schema_digest", "configuration_fingerprint"],
      "properties": {
        "version": {"const": "cymule.runtime-composition/1"},
        "provider_id": {"$ref": "#/$defs/token"},
        "implementation": {"$ref": "#/$defs/implementation"},
        "provides": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/service"}},
        "requires": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/service"}},
        "properties": {"type": "object", "maxProperties": 256, "propertyNames": {"$ref": "#/$defs/token"}, "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"}},
        "configuration_schema_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "configuration_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "providers"],
      "properties": {
        "version": {"const": "cymule.runtime-composition/1"},
        "providers": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/provider"}}
      }
    },
    "componentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "provider_id", "implementation", "operation_revision"],
      "properties": {
        "service": {"$ref": "#/$defs/service"},
        "provider_id": {"$ref": "#/$defs/token"},
        "implementation": {"$ref": "#/$defs/implementation"},
        "operation_revision": {"$ref": "#/$defs/token"}
      }
    },
    "effectBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "provider_id", "implementation", "operation_revision", "can_reconcile"],
      "properties": {
        "service": {"$ref": "#/$defs/service"},
        "provider_id": {"$ref": "#/$defs/token"},
        "implementation": {"$ref": "#/$defs/implementation"},
        "operation_revision": {"$ref": "#/$defs/token"},
        "can_reconcile": {"type": "boolean"}
      }
    }
  }
}
