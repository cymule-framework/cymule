    "virtualIdentity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
