{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cymule.dev/schemas/live-evolution-control.schema.json",
  "title": "Cymule Live Evolution Control cymule.live-evolution-control/6",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["control_version", "command_id", "operation", "logical_ref", "definition", "references"],
      "properties": {
        "control_version": { "const": "cymule.live-evolution-control/6" },
        "command_id": { "$ref": "#/$defs/id" },
        "operation": { "const": "publish_definition" },
        "logical_ref": { "$ref": "#/$defs/id" },
        "definition": { "$ref": "plan-candidate.schema.json#/$defs/definition" },
        "references": { "$ref": "#/$defs/publicationReferences" }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["control_version", "command_id", "operation", "template"],
      "properties": {
        "control_version": { "const": "cymule.live-evolution-control/6" },
        "command_id": { "$ref": "#/$defs/id" },
        "operation": { "const": "register_template" },
        "template": { "$ref": "#/$defs/template" }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["control_version", "command_id", "operation", "publication"],
      "properties": {
        "control_version": { "const": "cymule.live-evolution-control/6" },
        "command_id": { "$ref": "#/$defs/id" },
        "operation": { "const": "publish_and_relink" },
        "publication": { "$ref": "#/$defs/publication" }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["control_version", "command_id", "operation", "template_id", "command"],
      "properties": {
        "control_version": { "const": "cymule.live-evolution-control/6" },
        "command_id": { "$ref": "#/$defs/id" },
        "operation": { "const": "apply" },
        "template_id": { "$ref": "#/$defs/id" },
        "command": { "$ref": "evolution-control.schema.json" }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string", "minLength": 1, "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "runIdentity": {
      "type": "string", "minLength": 1, "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "schema": { "oneOf": [{ "type": "boolean" }, { "type": "object" }] },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["identity_version", "artifact_id", "kind"],
      "properties": {
        "identity_version": { "const": "cymule.artifact/2" },
        "artifact_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "kind": { "type": "string", "pattern": "^[a-z0-9._+-]+(?:/[a-z0-9._+-]+)+$", "maxLength": 255 }
      }
    },
    "artifactRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["reference", "bytes"],
      "properties": {
        "reference": { "$ref": "#/$defs/artifact" },
        "bytes": {
          "type": "string", "maxLength": 11184812,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/][AQgw]==|[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=)?(?![\\s\\S])",
          "allOf": [{ "if": { "minLength": 11184812 }, "then": { "pattern": "=$" } }]
        }
      }
    },
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["logical_ref", "local_definition", "input_schema", "output_schema", "strategy"],
      "properties": {
        "logical_ref": { "$ref": "#/$defs/id" },
        "local_definition": { "$ref": "#/$defs/id" },
        "input_schema": { "$ref": "#/$defs/schema" },
        "output_schema": { "$ref": "#/$defs/schema" },
        "strategy": {
          "oneOf": [
            {
              "type": "object", "additionalProperties": false,
              "required": ["strategy"],
              "properties": { "strategy": { "const": "latest_compatible" } }
            },
            {
              "type": "object", "additionalProperties": false,
              "required": ["strategy", "revision_id"],
              "properties": {
                "strategy": { "const": "pinned" },
                "revision_id": { "$ref": "#/$defs/id" }
              }
            }
          ]
        }
      }
    },
    "publicationReference": {
      "type": "object", "additionalProperties": false,
      "required": ["logical_ref", "local_definition", "input_schema", "output_schema", "strategy"],
      "properties": {
        "logical_ref": { "$ref": "#/$defs/id" },
        "local_definition": { "$ref": "#/$defs/id" },
        "input_schema": { "$ref": "#/$defs/schema" },
        "output_schema": { "$ref": "#/$defs/schema" },
        "strategy": {
          "type": "object", "additionalProperties": false,
          "required": ["strategy", "revision_id"],
          "properties": {
            "strategy": { "const": "pinned" },
            "revision_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        }
      }
    },
    "publicationReferences": {
      "type": "array", "maxItems": 1024,
      "items": { "$ref": "#/$defs/publicationReference" }
    },
    "template": {
      "type": "object", "additionalProperties": false,
      "required": ["template_id", "candidate", "references"],
      "properties": {
        "template_id": { "$ref": "#/$defs/id" },
        "candidate": { "$ref": "plan-candidate.schema.json" },
        "references": { "type": "array", "items": { "$ref": "#/$defs/reference" } }
      }
    },
    "publication": {
      "type": "object", "additionalProperties": false,
      "required": ["logical_ref", "definition", "references", "evidence", "mode"],
      "properties": {
        "logical_ref": { "$ref": "#/$defs/id" },
        "definition": { "$ref": "plan-candidate.schema.json#/$defs/definition" },
        "references": { "$ref": "#/$defs/publicationReferences" },
        "evidence": { "$ref": "#/$defs/artifactRecord" },
        "mode": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["mode"], "properties": { "mode": { "const": "shadow" } } },
            { "type": "object", "additionalProperties": false, "required": ["mode", "basis_points"], "properties": { "mode": { "const": "canary" }, "basis_points": { "type": "integer", "minimum": 0, "maximum": 10000 } } },
            { "type": "object", "additionalProperties": false, "required": ["mode"], "properties": { "mode": { "const": "active" } } },
            { "type": "object", "additionalProperties": false, "required": ["mode"], "properties": { "mode": { "const": "rolled_back" } } }
          ]
        }
      }
    }
  }
}
