{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cymule.dev/schemas/evolution-plugin.schema.json",
  "title": "Cymule Evolution Plugin Protocol cymule.evolution-plugin/3",
  "oneOf": [
    { "$ref": "#/$defs/requestEnvelope" },
    { "$ref": "#/$defs/responseEnvelope" }
  ],
  "$defs": {
    "contentId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "executionBinding": {
      "allOf": [
        { "$ref": "evolution-control.schema.json#/$defs/artifact" },
        {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "const": "cymule.execution-binding/2" }
          }
        }
      ]
    },
    "migrationProcessRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "source_witness_id",
        "source_continuation",
        "input_state",
        "source_binding",
        "target_binding"
      ],
      "properties": {
        "intent": { "$ref": "evolution-control.schema.json#/$defs/migration" },
        "source_witness_id": { "$ref": "#/$defs/contentId" },
        "source_continuation": { "$ref": "evolution-control.schema.json#/$defs/continuation" },
        "input_state": { "$ref": "evolution-control.schema.json#/$defs/artifact" },
        "source_binding": { "$ref": "#/$defs/executionBinding" },
        "target_binding": { "$ref": "#/$defs/executionBinding" }
      }
    },
    "requestEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evolution_plugin_protocol", "implementation_revision", "request"],
      "properties": {
        "evolution_plugin_protocol": { "const": "cymule.evolution-plugin/3" },
        "implementation_revision": { "$ref": "#/$defs/contentId" },
        "request": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type"],
              "properties": { "type": { "const": "describe_migration" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "request"],
              "properties": {
                "type": { "const": "migrate" },
                "request": { "$ref": "#/$defs/migrationProcessRequest" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type"],
              "properties": { "type": { "const": "describe_shadow" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "request"],
              "properties": {
                "type": { "const": "execute_shadow" },
                "request": { "$ref": "evolution-control.schema.json#/$defs/shadow" }
              }
            }
          ]
        }
      }
    },
    "responseEnvelope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "evolution_plugin_protocol", "response"],
          "properties": {
            "outcome": { "const": "success" },
            "evolution_plugin_protocol": { "const": "cymule.evolution-plugin/3" },
            "response": { "$ref": "#/$defs/success" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "evolution_plugin_protocol", "error"],
          "properties": {
            "outcome": { "const": "failure" },
            "evolution_plugin_protocol": { "const": "cymule.evolution-plugin/3" },
            "error": { "$ref": "#/$defs/failure" }
          }
        }
      ]
    },
    "success": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "descriptor"],
          "properties": {
            "type": { "const": "migration_descriptor" },
            "descriptor": { "$ref": "evolution-control.schema.json#/$defs/migrationDescriptor" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "output"],
          "properties": {
            "type": { "const": "migrated" },
            "output": { "$ref": "evolution-control.schema.json#/$defs/migrationOutput" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "descriptor"],
          "properties": {
            "type": { "const": "shadow_descriptor" },
            "descriptor": { "$ref": "evolution-control.schema.json#/$defs/shadowDescriptor" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "output"],
          "properties": {
            "type": { "const": "shadow_executed" },
            "output": { "$ref": "evolution-control.schema.json#/$defs/shadowOutput" }
          }
        }
      ]
    },
    "contractIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "instance_path", "schema_path", "message"],
      "properties": {
        "kind": { "enum": ["validation", "omitted"] },
        "instance_path": { "type": "string", "maxLength": 1000, "pattern": "^(|/[^\\u0000-\\u001f\\u007f-\\u009f]*)$" },
        "schema_path": { "type": "string", "maxLength": 1000, "pattern": "^(|/[^\\u0000-\\u001f\\u007f-\\u009f]*)$" },
        "message": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$" }
      },
      "allOf": [{
        "if": { "properties": { "kind": { "const": "omitted" } }, "required": ["kind"] },
        "then": {
          "properties": {
            "instance_path": { "const": "" },
            "schema_path": { "const": "" },
            "message": { "const": "additional contract issues were omitted after the fixed validation budget" }
          }
        }
      }]
    },
    "contractViolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "target", "issues"],
      "properties": {
        "phase": { "enum": ["admission", "execution"] },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["boundary", "id", "side"],
          "properties": {
            "boundary": { "enum": ["definition", "component", "effect", "wait"] },
            "id": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$" },
            "side": { "enum": ["input", "output"] }
          }
        },
        "issues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/contractIssue" }
        }
      }
    },
    "failure": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["category", "code", "message"],
          "properties": {
            "category": {
              "enum": ["cancelled", "timed_out", "integrity", "plugin_defect", "substrate"]
            },
            "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,199}$" },
            "message": { "type": "string", "minLength": 1, "maxLength": 2000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["category", "violation"],
          "properties": {
            "category": { "const": "contract" },
            "violation": { "$ref": "#/$defs/contractViolation" }
          }
        }
      ]
    }
  }
}
