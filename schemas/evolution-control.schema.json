{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cymule.dev/schemas/evolution-control.schema.json",
  "title": "Cymule Evolution Control cymule.evolution-control/2",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["control_version", "command_id", "operation", "patch"],
      "properties": {
        "control_version": { "const": "cymule.evolution-control/2" },
        "command_id": { "$ref": "#/$defs/id" },
        "operation": { "const": "apply_patch" },
        "patch": { "$ref": "#/$defs/patch" }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["control_version", "command_id", "operation", "decision"],
      "properties": {
        "control_version": { "const": "cymule.evolution-control/2" },
        "command_id": { "$ref": "#/$defs/id" },
        "operation": { "const": "set_rollout" },
        "decision": { "$ref": "#/$defs/decision" }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["control_version", "command_id", "operation", "occurrence_id"],
      "properties": {
        "control_version": { "const": "cymule.evolution-control/2" },
        "command_id": { "$ref": "#/$defs/id" },
        "operation": { "const": "select_occurrence" },
        "occurrence_id": { "$ref": "#/$defs/id" }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["control_version", "command_id", "operation", "request"],
      "properties": {
        "control_version": { "const": "cymule.evolution-control/2" },
        "command_id": { "$ref": "#/$defs/id" },
        "operation": { "const": "migrate" },
        "request": { "$ref": "#/$defs/migration" }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["control_version", "command_id", "operation", "request"],
      "properties": {
        "control_version": { "const": "cymule.evolution-control/2" },
        "command_id": { "$ref": "#/$defs/id" },
        "operation": { "const": "restart_under_new_plan" },
        "request": { "$ref": "#/$defs/restart" }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["control_version", "command_id", "operation", "request"],
      "properties": {
        "control_version": { "const": "cymule.evolution-control/2" },
        "command_id": { "$ref": "#/$defs/id" },
        "operation": { "const": "shadow" },
        "request": { "$ref": "#/$defs/shadow" }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["control_version", "command_id", "operation", "observation"],
      "properties": {
        "control_version": { "const": "cymule.evolution-control/2" },
        "command_id": { "$ref": "#/$defs/id" },
        "operation": { "const": "observe" },
        "observation": { "$ref": "#/$defs/observation" }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["control_version", "command_id", "operation", "gate", "next_decision_id"],
      "properties": {
        "control_version": { "const": "cymule.evolution-control/2" },
        "command_id": { "$ref": "#/$defs/id" },
        "operation": { "const": "apply_gate" },
        "gate": { "$ref": "#/$defs/gate" },
        "next_decision_id": { "$ref": "#/$defs/id" }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["identity_version", "artifact_id", "kind"],
      "properties": {
        "identity_version": { "const": "cymule.artifact/2" },
        "artifact_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "kind": { "type": "string", "pattern": "^[a-z0-9._+-]+(?:/[a-z0-9._+-]+)+$", "maxLength": 255 }
      }
    },
    "patchOperation": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "target", "before", "after"],
      "properties": {
        "kind": { "$ref": "#/$defs/id" },
        "target": { "$ref": "#/$defs/id" },
        "before": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "after": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
      }
    },
    "patch": {
      "type": "object", "additionalProperties": false,
      "required": ["from_plan", "target", "operations", "evidence"],
      "properties": {
        "from_plan": { "$ref": "#/$defs/id" },
        "target": { "$ref": "plan-candidate.schema.json" },
        "operations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/patchOperation" } },
        "evidence": { "$ref": "#/$defs/artifact" }
      }
    },
    "mode": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["mode"], "properties": { "mode": { "const": "shadow" } } },
        { "type": "object", "additionalProperties": false, "required": ["mode", "basis_points"], "properties": { "mode": { "const": "canary" }, "basis_points": { "type": "integer", "minimum": 0, "maximum": 10000 } } },
        { "type": "object", "additionalProperties": false, "required": ["mode"], "properties": { "mode": { "const": "active" } } },
        { "type": "object", "additionalProperties": false, "required": ["mode"], "properties": { "mode": { "const": "rolled_back" } } }
      ]
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["decision_id", "fallback_plan", "target_plan", "mode"],
      "properties": {
        "decision_id": { "$ref": "#/$defs/id" },
        "fallback_plan": { "$ref": "#/$defs/id" },
        "target_plan": { "$ref": "#/$defs/id" },
        "mode": { "$ref": "#/$defs/mode" }
      }
    },
    "migration": {
      "type": "object", "additionalProperties": false,
      "required": ["migration_id", "run_id", "from_plan", "to_plan", "safe_point_id", "source_epoch", "input_state"],
      "properties": {
        "migration_id": { "$ref": "#/$defs/id" },
        "run_id": { "$ref": "#/$defs/id" },
        "from_plan": { "$ref": "#/$defs/id" },
        "to_plan": { "$ref": "#/$defs/id" },
        "safe_point_id": { "$ref": "#/$defs/id" },
        "source_epoch": { "type": "integer", "minimum": 0 },
        "input_state": { "$ref": "#/$defs/artifact" }
      }
    },
    "restart": {
      "type": "object", "additionalProperties": false,
      "required": ["restart_id", "source_run", "replacement_run", "from_plan", "to_plan", "safe_point_id", "source_epoch", "input", "evidence"],
      "properties": {
        "restart_id": { "$ref": "#/$defs/id" },
        "source_run": { "$ref": "#/$defs/id" },
        "replacement_run": { "$ref": "#/$defs/id" },
        "from_plan": { "$ref": "#/$defs/id" },
        "to_plan": { "$ref": "#/$defs/id" },
        "safe_point_id": { "$ref": "#/$defs/id" },
        "source_epoch": { "type": "integer", "minimum": 0 },
        "input": { "$ref": "#/$defs/artifact" },
        "evidence": { "$ref": "#/$defs/artifact" }
      }
    },
    "shadow": {
      "type": "object", "additionalProperties": false,
      "required": ["comparison_id", "decision_id", "subject", "primary_plan", "shadow_plan", "input", "comparison_policy"],
      "properties": {
        "comparison_id": { "$ref": "#/$defs/id" },
        "decision_id": { "$ref": "#/$defs/id" },
        "subject": { "$ref": "#/$defs/id" },
        "primary_plan": { "$ref": "#/$defs/id" },
        "shadow_plan": { "$ref": "#/$defs/id" },
        "input": { "$ref": "#/$defs/artifact" },
        "comparison_policy": { "$ref": "#/$defs/id" }
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["observation_id", "decision_id", "occurrence_id", "plan_id", "outcome", "evidence"],
      "properties": {
        "observation_id": { "$ref": "#/$defs/id" },
        "decision_id": { "$ref": "#/$defs/id" },
        "occurrence_id": { "$ref": "#/$defs/id" },
        "plan_id": { "$ref": "#/$defs/id" },
        "outcome": { "enum": ["succeeded", "failed"] },
        "evidence": { "$ref": "#/$defs/artifact" }
      }
    },
    "gate": {
      "type": "object", "additionalProperties": false,
      "required": ["gate_id", "decision_id", "min_target_observations", "max_target_failures", "min_equivalent_shadows", "max_inequivalent_shadows"],
      "properties": {
        "gate_id": { "$ref": "#/$defs/id" },
        "decision_id": { "$ref": "#/$defs/id" },
        "min_target_observations": { "type": "integer", "minimum": 0 },
        "max_target_failures": { "type": "integer", "minimum": 0 },
        "min_equivalent_shadows": { "type": "integer", "minimum": 0 },
        "max_inequivalent_shadows": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
