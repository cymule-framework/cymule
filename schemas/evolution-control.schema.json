{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cymule.dev/schemas/evolution-control.schema.json",
  "title": "Cymule Evolution Control cymule.evolution-control/5",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["control_version", "command_id", "operation", "patch"],
      "properties": {
        "control_version": { "const": "cymule.evolution-control/5" },
        "command_id": { "$ref": "#/$defs/id" },
        "operation": { "const": "apply_patch" },
        "patch": { "$ref": "#/$defs/patch" }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["control_version", "command_id", "operation", "decision"],
      "properties": {
        "control_version": { "const": "cymule.evolution-control/5" },
        "command_id": { "$ref": "#/$defs/id" },
        "operation": { "const": "set_rollout" },
        "decision": { "$ref": "#/$defs/decision" }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["control_version", "command_id", "operation", "occurrence_id", "selection_id", "execution_binding"],
      "properties": {
        "control_version": { "const": "cymule.evolution-control/5" },
        "command_id": { "$ref": "#/$defs/id" },
        "operation": { "const": "select_occurrence" },
        "occurrence_id": { "$ref": "#/$defs/id" },
        "selection_id": { "$ref": "#/$defs/id" },
        "execution_binding": { "$ref": "#/$defs/executionBindingArtifact" }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["control_version", "command_id", "operation", "request"],
      "properties": {
        "control_version": { "const": "cymule.evolution-control/5" },
        "command_id": { "$ref": "#/$defs/id" },
        "operation": { "const": "migrate" },
        "request": { "$ref": "#/$defs/migration" }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["control_version", "command_id", "operation", "request"],
      "properties": {
        "control_version": { "const": "cymule.evolution-control/5" },
        "command_id": { "$ref": "#/$defs/id" },
        "operation": { "const": "restart_under_new_plan" },
        "request": { "$ref": "#/$defs/restart" }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["control_version", "command_id", "operation", "request"],
      "properties": {
        "control_version": { "const": "cymule.evolution-control/5" },
        "command_id": { "$ref": "#/$defs/id" },
        "operation": { "const": "shadow" },
        "request": { "$ref": "#/$defs/shadow" }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["control_version", "command_id", "operation", "observation"],
      "properties": {
        "control_version": { "const": "cymule.evolution-control/5" },
        "command_id": { "$ref": "#/$defs/id" },
        "operation": { "const": "observe" },
        "observation": { "$ref": "#/$defs/observation" }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["control_version", "command_id", "operation", "gate", "next_decision_id"],
      "properties": {
        "control_version": { "const": "cymule.evolution-control/5" },
        "command_id": { "$ref": "#/$defs/id" },
        "operation": { "const": "apply_gate" },
        "gate": { "$ref": "#/$defs/gate" },
        "next_decision_id": { "$ref": "#/$defs/id" }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string", "minLength": 1, "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "contentId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "runIdentity": {
      "type": "string", "minLength": 1, "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["identity_version", "artifact_id", "kind"],
      "properties": {
        "identity_version": { "const": "cymule.artifact/2" },
        "artifact_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "kind": { "type": "string", "pattern": "^[a-z0-9._+-]+(?:/[a-z0-9._+-]+)+$", "maxLength": 255 }
      }
    },
    "artifactRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["reference", "bytes"],
      "properties": {
        "reference": { "$ref": "#/$defs/artifact" },
        "bytes": {
          "type": "string", "maxLength": 11184812,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/][AQgw]==|[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=)?(?![\\s\\S])",
          "allOf": [{ "if": { "minLength": 11184812 }, "then": { "pattern": "=$" } }]
        }
      }
    },
    "migrationDescriptor": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter_id", "adapter_revision", "from_plan", "to_plan", "plan_edge_id", "compatibility_id", "from_schema", "to_schema", "state_coverage", "failure_and_cancellation", "budget_and_ownership", "authority_and_effects"],
      "properties": {
        "adapter_id": { "$ref": "#/$defs/id" },
        "adapter_revision": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "from_plan": { "$ref": "#/$defs/id" },
        "to_plan": { "$ref": "#/$defs/contentId" },
        "plan_edge_id": { "$ref": "#/$defs/id" },
        "compatibility_id": { "$ref": "#/$defs/id" },
        "from_schema": { "$ref": "#/$defs/id" },
        "to_schema": { "$ref": "#/$defs/id" },
        "state_coverage": { "const": "total_reachable_state" },
        "failure_and_cancellation": { "const": "preserved" },
        "budget_and_ownership": { "const": "preserved" },
        "authority_and_effects": { "const": "no_widening" }
      }
    },
    "migrationOutput": {
      "type": "object", "additionalProperties": false,
      "required": ["continuation", "artifacts", "evidence"],
      "properties": {
        "continuation": { "$ref": "#/$defs/continuation" },
        "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifactRecord" } },
        "evidence": { "$ref": "#/$defs/artifactRecord" }
      }
    },
    "shadowDescriptor": {
      "type": "object", "additionalProperties": false,
      "required": ["driver_id", "driver_revision", "target_effects", "occurrence_bindings"],
      "properties": {
        "driver_id": { "$ref": "#/$defs/id" },
        "driver_revision": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "target_effects": { "const": "suppressed_or_simulated" },
        "occurrence_bindings": { "const": "pinned" }
      }
    },
    "shadowOutput": {
      "type": "object", "additionalProperties": false,
      "required": ["primary_digest", "shadow_digest", "equivalent", "evidence"],
      "properties": {
        "primary_digest": { "$ref": "#/$defs/id" },
        "shadow_digest": { "$ref": "#/$defs/id" },
        "equivalent": { "type": "boolean" },
        "evidence": { "$ref": "#/$defs/artifactRecord" }
      }
    },
    "executionBindingArtifact": {
      "type": "object", "additionalProperties": false,
      "required": ["identity_version", "artifact_id", "kind"],
      "properties": {
        "identity_version": { "const": "cymule.artifact/2" },
        "artifact_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "kind": { "const": "cymule.execution-binding/2" }
      }
    },
    "occurrencePin": {
      "type": "object", "additionalProperties": false,
      "required": ["occurrence_id", "template_id", "decision_id", "plan_id", "execution_binding", "selection_id"],
      "properties": {
        "occurrence_id": { "$ref": "#/$defs/id" },
        "template_id": { "$ref": "#/$defs/id" },
        "decision_id": { "$ref": "#/$defs/id" },
        "plan_id": { "$ref": "#/$defs/contentId" },
        "execution_binding": { "$ref": "#/$defs/executionBindingArtifact" },
        "selection_id": { "$ref": "#/$defs/id" }
      }
    },
    "patchOperation": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "target", "before", "after"],
      "properties": {
        "kind": { "$ref": "#/$defs/id" },
        "target": { "$ref": "#/$defs/id" },
        "before": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "after": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
      }
    },
    "patch": {
      "type": "object", "additionalProperties": false,
      "required": ["from_plan", "target", "operations", "evidence"],
      "properties": {
        "from_plan": { "$ref": "#/$defs/id" },
        "target": { "$ref": "plan-candidate.schema.json" },
        "operations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/patchOperation" } },
        "evidence": { "$ref": "#/$defs/artifact" }
      }
    },
    "mode": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["mode"], "properties": { "mode": { "const": "shadow" } } },
        { "type": "object", "additionalProperties": false, "required": ["mode", "basis_points"], "properties": { "mode": { "const": "canary" }, "basis_points": { "type": "integer", "minimum": 0, "maximum": 10000 } } },
        { "type": "object", "additionalProperties": false, "required": ["mode"], "properties": { "mode": { "const": "active" } } },
        { "type": "object", "additionalProperties": false, "required": ["mode"], "properties": { "mode": { "const": "rolled_back" } } }
      ]
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["decision_id", "fallback_plan", "target_plan", "mode"],
      "properties": {
        "decision_id": { "$ref": "#/$defs/id" },
        "fallback_plan": { "$ref": "#/$defs/id" },
        "target_plan": { "$ref": "#/$defs/id" },
        "mode": { "$ref": "#/$defs/mode" }
      }
    },
    "migration": {
      "type": "object", "additionalProperties": false,
      "required": ["migration_id", "run_id", "from_plan", "to_plan", "plan_edge_id", "compatibility_id", "expected_source_epoch", "adapter_id", "adapter_revision"],
      "properties": {
        "migration_id": { "$ref": "#/$defs/id" },
        "run_id": { "$ref": "#/$defs/runIdentity" },
        "from_plan": { "$ref": "#/$defs/contentId" },
        "to_plan": { "$ref": "#/$defs/contentId" },
        "plan_edge_id": { "$ref": "#/$defs/contentId" },
        "compatibility_id": { "$ref": "#/$defs/contentId" },
        "expected_source_epoch": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "adapter_id": { "$ref": "#/$defs/id" },
        "adapter_revision": { "$ref": "#/$defs/contentId" }
      }
    },
    "invocationPathSegment": {
      "type": "object", "additionalProperties": false,
      "required": ["site_id", "region_path", "scope_id"],
      "properties": {
        "site_id": { "$ref": "#/$defs/id" },
        "region_path": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 } },
        "scope_id": { "$ref": "#/$defs/id" }
      }
    },
    "frame": {
      "type": "object", "additionalProperties": false,
      "required": ["definition_id", "invocation_id", "invocation_path", "scope_id", "input", "region_path", "next_step", "locals"],
      "properties": {
        "definition_id": { "$ref": "#/$defs/id" },
        "invocation_id": { "$ref": "#/$defs/id" },
        "invocation_path": { "type": "array", "items": { "$ref": "#/$defs/invocationPathSegment" } },
        "scope_id": { "$ref": "#/$defs/id" },
        "input": { "$ref": "#/$defs/artifact" },
        "region_path": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 } },
        "next_step": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "locals": { "type": "object", "additionalProperties": { "$ref": "#/$defs/artifact" } }
      }
    },
    "continuation": {
      "type": "object", "additionalProperties": false,
      "required": ["continuation_version", "run_id", "plan_id", "binding_context", "frames", "state", "wait_set", "scope_stack", "epoch", "execution_fence", "execution_claim", "status"],
      "properties": {
        "continuation_version": { "const": "cymule.continuation-state/1" },
        "run_id": { "$ref": "#/$defs/runIdentity" },
        "plan_id": { "$ref": "#/$defs/contentId" },
        "binding_context": { "$ref": "#/$defs/id" },
        "frames": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/frame" } },
        "state": { "oneOf": [{ "$ref": "#/$defs/artifact" }, { "type": "null" }] },
        "wait_set": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "scope_stack": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
        "epoch": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "execution_fence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "execution_claim": { "type": "null" },
        "status": { "const": "ready" }
      }
    },
    "restart": {
      "type": "object", "additionalProperties": false,
      "required": ["restart_id", "replacement_run", "run_id", "from_plan", "expected_source_epoch", "to_plan", "input", "evidence"],
      "properties": {
        "restart_id": { "$ref": "#/$defs/id" },
        "replacement_run": { "$ref": "#/$defs/runIdentity" },
        "run_id": { "$ref": "#/$defs/runIdentity" },
        "from_plan": { "$ref": "#/$defs/contentId" },
        "expected_source_epoch": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "to_plan": { "$ref": "#/$defs/contentId" },
        "input": { "$ref": "#/$defs/artifact" },
        "evidence": { "$ref": "#/$defs/artifact" }
      }
    },
    "shadow": {
      "type": "object", "additionalProperties": false,
      "required": ["comparison_id", "decision_id", "subject", "primary_plan", "shadow_plan", "driver_id", "driver_revision", "input", "comparison_policy"],
      "properties": {
        "comparison_id": { "$ref": "#/$defs/id" },
        "decision_id": { "$ref": "#/$defs/id" },
        "subject": { "$ref": "#/$defs/id" },
        "primary_plan": { "$ref": "#/$defs/contentId" },
        "shadow_plan": { "$ref": "#/$defs/contentId" },
        "driver_id": { "$ref": "#/$defs/id" },
        "driver_revision": { "$ref": "#/$defs/contentId" },
        "input": { "$ref": "#/$defs/artifact" },
        "comparison_policy": { "$ref": "#/$defs/id" }
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["observation_id", "decision_id", "occurrence_id", "plan_id", "outcome", "evidence"],
      "properties": {
        "observation_id": { "$ref": "#/$defs/id" },
        "decision_id": { "$ref": "#/$defs/id" },
        "occurrence_id": { "$ref": "#/$defs/id" },
        "plan_id": { "$ref": "#/$defs/contentId" },
        "outcome": { "enum": ["succeeded", "failed"] },
        "evidence": { "$ref": "#/$defs/artifact" }
      }
    },
    "gate": {
      "type": "object", "additionalProperties": false,
      "required": ["gate_id", "decision_id", "min_target_observations", "max_target_failures", "min_equivalent_shadows", "max_inequivalent_shadows"],
      "properties": {
        "gate_id": { "$ref": "#/$defs/id" },
        "decision_id": { "$ref": "#/$defs/id" },
        "min_target_observations": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "max_target_failures": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "min_equivalent_shadows": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "max_inequivalent_shadows": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    }
  }
}
