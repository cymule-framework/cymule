{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cymule.dev/schemas/durable-storage.schema.json",
  "title": "Cymule Durable Storage Records",
  "$defs": {
    "identity": { "type": "string", "minLength": 1 },
    "machine_delta": {
      "type": "object",
      "properties": {
        "delta_version": { "const": "cymule.machine-delta/1" },
        "plans": { "type": "array", "items": { "type": "object" } },
        "artifacts": { "type": "array", "items": { "type": "object" } },
        "compacted_event_ids": { "type": "array", "items": { "$ref": "#/$defs/identity" }, "uniqueItems": true },
        "base": { "type": "object" },
        "events": { "type": "array", "items": { "type": "object" } },
        "commands": { "type": "object" }
      },
      "required": ["delta_version", "plans", "artifacts", "compacted_event_ids", "events", "commands"],
      "additionalProperties": false
    },
    "durable_delta": {
      "type": "object",
      "properties": {
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": { "op": { "const": "apply_machine" }, "delta": { "$ref": "#/$defs/machine_delta" } },
                "required": ["op", "delta"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": { "enum": ["put_continuation", "put_wait", "put_wait_activation", "put_lease", "put_outbox", "put_component_occurrence", "put_snapshot", "put_history_compaction"] },
                  "value": { "type": "object" }
                },
                "required": ["op", "value"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": { "const": "append_journal" },
                  "journal_id": { "$ref": "#/$defs/identity" },
                  "records": { "type": "array", "minItems": 1, "items": { "type": "object" } }
                },
                "required": ["op", "journal_id", "records"],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": ["operations"],
      "additionalProperties": false
    },
    "head": {
      "type": "object",
      "properties": {
        "head_version": { "const": "cymule.durable-head/1" },
        "revision": { "$ref": "#/$defs/identity" },
        "checkpoint_id": { "$ref": "#/$defs/identity" },
        "checkpoint_depth": { "type": "integer", "minimum": 0, "maximum": 31 },
        "suffix_head": { "oneOf": [{ "$ref": "#/$defs/identity" }, { "type": "null" }] },
        "suffix_len": { "type": "integer", "minimum": 0, "maximum": 31 },
        "sequence": { "type": "integer", "minimum": 0 },
        "gc_receipt": { "oneOf": [{ "$ref": "#/$defs/identity" }, { "type": "null" }] }
      },
      "required": ["head_version", "revision", "checkpoint_id", "checkpoint_depth", "suffix_head", "suffix_len", "sequence", "gc_receipt"],
      "additionalProperties": false
    },
    "segment": {
      "type": "object",
      "properties": {
        "segment_version": { "const": "cymule.durable-segment/2" },
        "segment_id": { "$ref": "#/$defs/identity" },
        "sequence": { "type": "integer", "minimum": 1 },
        "parent_segment": { "oneOf": [{ "$ref": "#/$defs/identity" }, { "type": "null" }] },
        "base_revision": { "$ref": "#/$defs/identity" },
        "revision": { "$ref": "#/$defs/identity" },
        "delta": { "$ref": "#/$defs/durable_delta" }
      },
      "required": ["segment_version", "segment_id", "sequence", "parent_segment", "base_revision", "revision", "delta"],
      "additionalProperties": false
    },
    "checkpoint": {
      "type": "object",
      "properties": {
        "checkpoint_version": { "const": "cymule.durable-checkpoint/1" },
        "checkpoint_id": { "$ref": "#/$defs/identity" },
        "parent_checkpoint": { "oneOf": [{ "$ref": "#/$defs/identity" }, { "type": "null" }] },
        "covered_segment": { "oneOf": [{ "$ref": "#/$defs/identity" }, { "type": "null" }] },
        "sequence": { "type": "integer", "minimum": 0 },
        "revision": { "$ref": "#/$defs/identity" },
        "state": { "oneOf": [{ "type": "object" }, { "type": "null" }] }
      },
      "required": ["checkpoint_version", "checkpoint_id", "parent_checkpoint", "covered_segment", "sequence", "revision", "state"],
      "additionalProperties": false
    },
    "gc_receipt": {
      "type": "object",
      "properties": {
        "receipt_version": { "const": "cymule.durable-gc-receipt/1" },
        "receipt_id": { "$ref": "#/$defs/identity" },
        "revision": { "$ref": "#/$defs/identity" },
        "retained_checkpoint": { "$ref": "#/$defs/identity" },
        "reclaimed_digest": { "$ref": "#/$defs/identity" },
        "reclaimed_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/identity" },
          "uniqueItems": true
        },
        "reclaimed_objects": { "type": "integer", "minimum": 0 }
      },
      "required": ["receipt_version", "receipt_id", "revision", "retained_checkpoint", "reclaimed_digest", "reclaimed_ids", "reclaimed_objects"],
      "additionalProperties": false
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/head" },
    { "$ref": "#/$defs/segment" },
    { "$ref": "#/$defs/checkpoint" },
    { "$ref": "#/$defs/gc_receipt" }
  ]
}
