{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cymule.dev/schemas/virtual-checkpoint.schema.json",
  "title": "Cymule Virtual Checkpoint cymule.virtual-checkpoint/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checkpoint_version", "checkpoint_id", "parent_checkpoint", "snapshot",
    "control", "receipt_occurrence_id", "migration_control", "receipt_migration_id"
  ],
  "properties": {
    "checkpoint_version": { "const": "cymule.virtual-checkpoint/1" },
    "checkpoint_id": { "$ref": "#/$defs/nonEmpty" },
    "parent_checkpoint": {
      "oneOf": [{ "$ref": "#/$defs/nonEmpty" }, { "type": "null" }]
    },
    "snapshot": { "$ref": "#/$defs/snapshot" },
    "control": {
      "oneOf": [{ "$ref": "#/$defs/controlCommand" }, { "type": "null" }]
    },
    "receipt_occurrence_id": {
      "oneOf": [{ "$ref": "#/$defs/nonEmpty" }, { "type": "null" }]
    },
    "migration_control": {
      "oneOf": [{ "$ref": "#/$defs/migrationControlCommand" }, { "type": "null" }]
    },
    "receipt_migration_id": {
      "oneOf": [{ "$ref": "#/$defs/nonEmpty" }, { "type": "null" }]
    }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "kind"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/nonEmpty" },
        "kind": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "position", "exhausted"],
      "properties": {
        "version": { "$ref": "#/$defs/nonEmpty" },
        "position": { "type": "string" },
        "exhausted": { "type": "boolean" }
      }
    },
    "schedulingPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_quantum", "aging_interval"],
      "properties": {
        "base_quantum": { "type": "integer", "minimum": 1 },
        "aging_interval": { "type": "integer", "minimum": 1 }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_id", "run_id", "source", "cursor", "estimated_total"],
      "properties": {
        "region_id": { "$ref": "#/$defs/nonEmpty" },
        "run_id": { "$ref": "#/$defs/nonEmpty" },
        "source": { "$ref": "#/$defs/nonEmpty" },
        "cursor": { "$ref": "#/$defs/cursor" },
        "estimated_total": {
          "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        }
      }
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_id", "region_id", "run_id", "payload", "capability", "priority", "cost"],
      "properties": {
        "work_id": { "$ref": "#/$defs/nonEmpty" },
        "region_id": { "$ref": "#/$defs/nonEmpty" },
        "run_id": { "$ref": "#/$defs/nonEmpty" },
        "payload": { "$ref": "#/$defs/artifact" },
        "capability": {
          "oneOf": [{ "$ref": "#/$defs/nonEmpty" }, { "type": "null" }]
        },
        "priority": { "type": "integer" },
        "cost": { "type": "integer", "minimum": 1 }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item", "owner", "epoch", "occurrence_id", "occurrence_binding"],
      "properties": {
        "item": { "$ref": "#/$defs/work" },
        "owner": { "$ref": "#/$defs/nonEmpty" },
        "epoch": { "type": "integer", "minimum": 1 },
        "occurrence_id": { "$ref": "#/$defs/nonEmpty" },
        "occurrence_binding": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "parkReason": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "key"],
          "properties": { "kind": { "const": "wait" }, "key": { "$ref": "#/$defs/nonEmpty" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "work_id"],
          "properties": { "kind": { "const": "dependency" }, "work_id": { "$ref": "#/$defs/nonEmpty" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "account"],
          "properties": { "kind": { "const": "budget" }, "account": { "$ref": "#/$defs/nonEmpty" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "capability"],
          "properties": { "kind": { "const": "capability" }, "capability": { "$ref": "#/$defs/nonEmpty" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "domain"],
          "properties": { "kind": { "const": "backpressure" }, "domain": { "$ref": "#/$defs/nonEmpty" } }
        }
      ]
    },
    "parked": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item", "reason"],
      "properties": {
        "item": { "$ref": "#/$defs/work" },
        "reason": { "$ref": "#/$defs/parkReason" }
      }
    },
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "occurrence_version", "occurrence_id", "work_id", "region_id", "run_id",
        "owner", "epoch", "occurrence_binding", "state", "result", "error", "next_reason"
      ],
      "properties": {
        "occurrence_version": { "const": "cymule.virtual-work-occurrence/1" },
        "occurrence_id": { "$ref": "#/$defs/nonEmpty" },
        "work_id": { "$ref": "#/$defs/nonEmpty" },
        "region_id": { "$ref": "#/$defs/nonEmpty" },
        "run_id": { "$ref": "#/$defs/nonEmpty" },
        "owner": { "$ref": "#/$defs/nonEmpty" },
        "epoch": { "type": "integer", "minimum": 1 },
        "occurrence_binding": { "$ref": "#/$defs/nonEmpty" },
        "state": {
          "enum": ["running", "succeeded", "retry_scheduled", "parked", "failed", "cancelled"]
        },
        "result": { "oneOf": [{ "$ref": "#/$defs/artifact" }, { "type": "null" }] },
        "error": { "oneOf": [{ "$ref": "#/$defs/artifact" }, { "type": "null" }] },
        "next_reason": { "oneOf": [{ "$ref": "#/$defs/parkReason" }, { "type": "null" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "running" } } },
          "then": {
            "properties": {
              "result": { "type": "null" }, "error": { "type": "null" },
              "next_reason": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "succeeded" } } },
          "then": {
            "properties": {
              "result": { "$ref": "#/$defs/artifact" }, "error": { "type": "null" },
              "next_reason": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "retry_scheduled" } } },
          "then": {
            "properties": {
              "result": { "type": "null" }, "error": { "$ref": "#/$defs/artifact" }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "parked" } } },
          "then": {
            "properties": {
              "result": { "type": "null" }, "error": { "type": "null" },
              "next_reason": { "$ref": "#/$defs/parkReason" }
            }
          }
        },
        {
          "if": { "properties": { "state": { "enum": ["failed", "cancelled"] } } },
          "then": {
            "properties": {
              "result": { "type": "null" }, "error": { "$ref": "#/$defs/artifact" },
              "next_reason": { "type": "null" }
            }
          }
        }
      ]
    },
    "resolution": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["resolution", "result"],
          "properties": {
            "resolution": { "const": "succeeded" }, "result": { "$ref": "#/$defs/artifact" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["resolution", "error", "next_reason"],
          "properties": {
            "resolution": { "const": "retry" },
            "error": { "$ref": "#/$defs/artifact" },
            "next_reason": { "oneOf": [{ "$ref": "#/$defs/parkReason" }, { "type": "null" }] }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["resolution", "reason"],
          "properties": {
            "resolution": { "const": "parked" }, "reason": { "$ref": "#/$defs/parkReason" }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["resolution", "error"],
          "properties": {
            "resolution": { "const": "failed" }, "error": { "$ref": "#/$defs/artifact" }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["resolution", "reason"],
          "properties": {
            "resolution": { "const": "cancelled" }, "reason": { "$ref": "#/$defs/artifact" }
          }
        }
      ]
    },
    "controlCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_version", "command_id", "work_id", "owner", "epoch", "resolution"],
      "properties": {
        "control_version": { "const": "cymule.virtual-work-control/1" },
        "command_id": { "$ref": "#/$defs/nonEmpty" },
        "work_id": { "$ref": "#/$defs/nonEmpty" },
        "owner": { "$ref": "#/$defs/nonEmpty" },
        "epoch": { "type": "integer", "minimum": 1 },
        "resolution": { "$ref": "#/$defs/resolution" }
      }
    },
    "migrationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["migration_id", "kind", "source_region_ids", "target_count", "migration_binding"],
      "properties": {
        "migration_id": { "$ref": "#/$defs/nonEmpty" },
        "kind": { "enum": ["split", "merge"] },
        "source_region_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmpty" }
        },
        "target_count": { "type": "integer", "minimum": 1 },
        "migration_binding": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "migrationPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "migration_version", "migration_id", "kind", "expected_sources", "targets",
        "migration_binding", "coverage_evidence"
      ],
      "properties": {
        "migration_version": { "const": "cymule.virtual-region-migration/1" },
        "migration_id": { "$ref": "#/$defs/nonEmpty" },
        "kind": { "enum": ["split", "merge"] },
        "expected_sources": {
          "type": "object", "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/cursor" }
        },
        "targets": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/$defs/region" }
        },
        "migration_binding": { "$ref": "#/$defs/nonEmpty" },
        "coverage_evidence": { "$ref": "#/$defs/artifact" }
      }
    },
    "migrationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "retired_regions", "active_targets"],
      "properties": {
        "plan": { "$ref": "#/$defs/migrationPlan" },
        "retired_regions": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmpty" }
        },
        "active_targets": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmpty" }
        }
      }
    },
    "migrationControlCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_version", "command_id", "plan"],
      "properties": {
        "control_version": { "const": "cymule.virtual-region-migration-control/1" },
        "command_id": { "$ref": "#/$defs/nonEmpty" },
        "plan": { "$ref": "#/$defs/migrationPlan" }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheduling_policy", "regions", "ready", "active", "parked", "known", "last_run",
        "last_region",
        "claim_epochs", "occurrences", "run_weights", "run_deficits", "dispatch_sequence",
        "ready_since", "retired_regions", "migrations"
      ],
      "properties": {
        "scheduling_policy": { "$ref": "#/$defs/schedulingPolicy" },
        "regions": { "type": "object", "additionalProperties": { "$ref": "#/$defs/region" } },
        "ready": {
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/work" } }
        },
        "active": { "type": "object", "additionalProperties": { "$ref": "#/$defs/claim" } },
        "parked": { "type": "object", "additionalProperties": { "$ref": "#/$defs/parked" } },
        "known": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
        "last_run": { "oneOf": [{ "$ref": "#/$defs/nonEmpty" }, { "type": "null" }] },
        "last_region": { "oneOf": [{ "$ref": "#/$defs/nonEmpty" }, { "type": "null" }] },
        "claim_epochs": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 1 }
        },
        "occurrences": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/occurrence" }
        },
        "run_weights": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 1 }
        },
        "run_deficits": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "dispatch_sequence": { "type": "integer", "minimum": 0 },
        "ready_since": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "retired_regions": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/nonEmpty" }
        },
        "migrations": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/migrationReceipt" }
        }
      }
    }
  }
}
