{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cymule.dev/schemas/virtual-checkpoint.schema.json",
  "title": "Cymule Virtual Checkpoint cymule.virtual-checkpoint/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checkpoint_version", "checkpoint_id", "parent_checkpoint", "snapshot",
    "control", "receipt_occurrence_id", "migration_control", "receipt_migration_id",
    "compaction_control", "receipt_compaction_id", "rehydration_control",
    "receipt_rehydration_id", "claim_control", "receipt_claim_id",
    "lease_renewal_control", "receipt_lease_renewal_id", "recovery_control",
    "receipt_recovery_id", "run_weight_control", "receipt_run_weight_id"
  ],
  "properties": {
    "checkpoint_version": { "const": "cymule.virtual-checkpoint/1" },
    "checkpoint_id": { "$ref": "#/$defs/nonEmpty" },
    "parent_checkpoint": {
      "oneOf": [{ "$ref": "#/$defs/nonEmpty" }, { "type": "null" }]
    },
    "snapshot": { "$ref": "#/$defs/snapshot" },
    "control": {
      "oneOf": [{ "$ref": "#/$defs/controlCommand" }, { "type": "null" }]
    },
    "receipt_occurrence_id": {
      "oneOf": [{ "$ref": "#/$defs/nonEmpty" }, { "type": "null" }]
    },
    "migration_control": {
      "oneOf": [{ "$ref": "#/$defs/migrationControlCommand" }, { "type": "null" }]
    },
    "receipt_migration_id": {
      "oneOf": [{ "$ref": "#/$defs/nonEmpty" }, { "type": "null" }]
    },
    "compaction_control": {
      "oneOf": [{ "$ref": "#/$defs/compactionControlCommand" }, { "type": "null" }]
    },
    "receipt_compaction_id": {
      "oneOf": [{ "$ref": "#/$defs/nonEmpty" }, { "type": "null" }]
    },
    "rehydration_control": {
      "oneOf": [{ "$ref": "#/$defs/rehydrationControlCommand" }, { "type": "null" }]
    },
    "receipt_rehydration_id": {
      "oneOf": [{ "$ref": "#/$defs/nonEmpty" }, { "type": "null" }]
    },
    "claim_control": {
      "oneOf": [{ "$ref": "#/$defs/claimControlCommand" }, { "type": "null" }]
    },
    "receipt_claim_id": {
      "oneOf": [{ "$ref": "#/$defs/nonEmpty" }, { "type": "null" }]
    },
    "lease_renewal_control": {
      "oneOf": [{ "$ref": "#/$defs/leaseRenewalControlCommand" }, { "type": "null" }]
    },
    "receipt_lease_renewal_id": {
      "oneOf": [{ "$ref": "#/$defs/nonEmpty" }, { "type": "null" }]
    },
    "recovery_control": {
      "oneOf": [{ "$ref": "#/$defs/recoveryControlCommand" }, { "type": "null" }]
    },
    "receipt_recovery_id": {
      "oneOf": [{ "$ref": "#/$defs/nonEmpty" }, { "type": "null" }]
    },
    "run_weight_control": {
      "oneOf": [{ "$ref": "#/$defs/runWeightControlCommand" }, { "type": "null" }]
    },
    "receipt_run_weight_id": {
      "oneOf": [{ "$ref": "#/$defs/nonEmpty" }, { "type": "null" }]
    }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_version", "artifact_id", "kind"],
      "properties": {
        "identity_version": { "const": "cymule.artifact/2" },
        "artifact_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "kind": { "type": "string", "pattern": "^[a-z0-9._+-]+(?:/[a-z0-9._+-]+)+$", "maxLength": 255 }
      }
    },
    "cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "position", "exhausted"],
      "properties": {
        "version": { "$ref": "#/$defs/nonEmpty" },
        "position": { "type": "string" },
        "exhausted": { "type": "boolean" }
      }
    },
    "schedulingPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_quantum", "aging_interval"],
      "properties": {
        "base_quantum": { "type": "integer", "minimum": 1 },
        "aging_interval": { "type": "integer", "minimum": 1 }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_id", "run_id", "source", "cursor", "estimated_total"],
      "properties": {
        "region_id": { "$ref": "#/$defs/nonEmpty" },
        "run_id": { "$ref": "#/$defs/nonEmpty" },
        "source": { "$ref": "#/$defs/nonEmpty" },
        "cursor": { "$ref": "#/$defs/cursor" },
        "estimated_total": {
          "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        }
      }
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_id", "region_id", "run_id", "payload", "capability", "priority", "cost"],
      "properties": {
        "work_id": { "$ref": "#/$defs/nonEmpty" },
        "region_id": { "$ref": "#/$defs/nonEmpty" },
        "run_id": { "$ref": "#/$defs/nonEmpty" },
        "payload": { "$ref": "#/$defs/artifact" },
        "capability": {
          "oneOf": [{ "$ref": "#/$defs/nonEmpty" }, { "type": "null" }]
        },
        "priority": { "type": "integer" },
        "cost": { "type": "integer", "minimum": 1 }
      }
    },
    "claimLease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource", "owner", "epoch", "expires_at"],
      "properties": {
        "resource": { "$ref": "#/$defs/nonEmpty" },
        "owner": { "$ref": "#/$defs/nonEmpty" },
        "epoch": { "type": "integer", "minimum": 1 },
        "expires_at": { "type": "integer", "minimum": 0 }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item", "owner", "epoch", "occurrence_id", "occurrence_binding", "lease"],
      "properties": {
        "item": { "$ref": "#/$defs/work" },
        "owner": { "$ref": "#/$defs/nonEmpty" },
        "epoch": { "type": "integer", "minimum": 1 },
        "occurrence_id": { "$ref": "#/$defs/nonEmpty" },
        "occurrence_binding": { "$ref": "#/$defs/nonEmpty" },
        "lease": { "$ref": "#/$defs/claimLease" }
      }
    },
    "parkReason": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "key"],
          "properties": { "kind": { "const": "wait" }, "key": { "$ref": "#/$defs/nonEmpty" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "work_id"],
          "properties": { "kind": { "const": "dependency" }, "work_id": { "$ref": "#/$defs/nonEmpty" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "account"],
          "properties": { "kind": { "const": "budget" }, "account": { "$ref": "#/$defs/nonEmpty" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "capability"],
          "properties": { "kind": { "const": "capability" }, "capability": { "$ref": "#/$defs/nonEmpty" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "domain"],
          "properties": { "kind": { "const": "backpressure" }, "domain": { "$ref": "#/$defs/nonEmpty" } }
        }
      ]
    },
    "parked": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item", "reason"],
      "properties": {
        "item": { "$ref": "#/$defs/work" },
        "reason": { "$ref": "#/$defs/parkReason" }
      }
    },
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "occurrence_version", "occurrence_id", "work_id", "region_id", "run_id",
        "owner", "epoch", "lease_epoch", "occurrence_binding", "state", "result", "error", "next_reason"
      ],
      "properties": {
        "occurrence_version": { "const": "cymule.virtual-work-occurrence/1" },
        "occurrence_id": { "$ref": "#/$defs/nonEmpty" },
        "work_id": { "$ref": "#/$defs/nonEmpty" },
        "region_id": { "$ref": "#/$defs/nonEmpty" },
        "run_id": { "$ref": "#/$defs/nonEmpty" },
        "owner": { "$ref": "#/$defs/nonEmpty" },
        "epoch": { "type": "integer", "minimum": 1 },
        "lease_epoch": { "type": "integer", "minimum": 1 },
        "occurrence_binding": { "$ref": "#/$defs/nonEmpty" },
        "state": {
          "enum": ["running", "succeeded", "retry_scheduled", "parked", "failed", "cancelled"]
        },
        "result": { "oneOf": [{ "$ref": "#/$defs/artifact" }, { "type": "null" }] },
        "error": { "oneOf": [{ "$ref": "#/$defs/artifact" }, { "type": "null" }] },
        "next_reason": { "oneOf": [{ "$ref": "#/$defs/parkReason" }, { "type": "null" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "running" } } },
          "then": {
            "properties": {
              "result": { "type": "null" }, "error": { "type": "null" },
              "next_reason": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "succeeded" } } },
          "then": {
            "properties": {
              "result": { "$ref": "#/$defs/artifact" }, "error": { "type": "null" },
              "next_reason": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "retry_scheduled" } } },
          "then": {
            "properties": {
              "result": { "type": "null" }, "error": { "$ref": "#/$defs/artifact" }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "parked" } } },
          "then": {
            "properties": {
              "result": { "type": "null" }, "error": { "type": "null" },
              "next_reason": { "$ref": "#/$defs/parkReason" }
            }
          }
        },
        {
          "if": { "properties": { "state": { "enum": ["failed", "cancelled"] } } },
          "then": {
            "properties": {
              "result": { "type": "null" }, "error": { "$ref": "#/$defs/artifact" },
              "next_reason": { "type": "null" }
            }
          }
        }
      ]
    },
    "resolution": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["resolution", "result"],
          "properties": {
            "resolution": { "const": "succeeded" }, "result": { "$ref": "#/$defs/artifact" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["resolution", "error", "next_reason"],
          "properties": {
            "resolution": { "const": "retry" },
            "error": { "$ref": "#/$defs/artifact" },
            "next_reason": { "oneOf": [{ "$ref": "#/$defs/parkReason" }, { "type": "null" }] }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["resolution", "reason"],
          "properties": {
            "resolution": { "const": "parked" }, "reason": { "$ref": "#/$defs/parkReason" }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["resolution", "error"],
          "properties": {
            "resolution": { "const": "failed" }, "error": { "$ref": "#/$defs/artifact" }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["resolution", "reason"],
          "properties": {
            "resolution": { "const": "cancelled" }, "reason": { "$ref": "#/$defs/artifact" }
          }
        }
      ]
    },
    "controlCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_version", "command_id", "work_id", "owner", "epoch",
        "expected_lease_epoch", "observed_at", "resolution"
      ],
      "properties": {
        "control_version": { "const": "cymule.virtual-work-control/1" },
        "command_id": { "$ref": "#/$defs/nonEmpty" },
        "work_id": { "$ref": "#/$defs/nonEmpty" },
        "owner": { "$ref": "#/$defs/nonEmpty" },
        "epoch": { "type": "integer", "minimum": 1 },
        "expected_lease_epoch": { "type": "integer", "minimum": 1 },
        "observed_at": { "type": "integer", "minimum": 0 },
        "resolution": { "$ref": "#/$defs/resolution" }
      }
    },
    "migrationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["migration_id", "kind", "source_region_ids", "target_count", "migration_binding"],
      "properties": {
        "migration_id": { "$ref": "#/$defs/nonEmpty" },
        "kind": { "enum": ["split", "merge"] },
        "source_region_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmpty" }
        },
        "target_count": { "type": "integer", "minimum": 1 },
        "migration_binding": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "migrationPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "migration_version", "migration_id", "kind", "expected_sources", "targets",
        "migration_binding", "coverage_evidence"
      ],
      "properties": {
        "migration_version": { "const": "cymule.virtual-region-migration/1" },
        "migration_id": { "$ref": "#/$defs/nonEmpty" },
        "kind": { "enum": ["split", "merge"] },
        "expected_sources": {
          "type": "object", "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/cursor" }
        },
        "targets": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/$defs/region" }
        },
        "migration_binding": { "$ref": "#/$defs/nonEmpty" },
        "coverage_evidence": { "$ref": "#/$defs/artifact" }
      }
    },
    "migrationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "retired_regions", "active_targets"],
      "properties": {
        "plan": { "$ref": "#/$defs/migrationPlan" },
        "retired_regions": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmpty" }
        },
        "active_targets": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmpty" }
        }
      }
    },
    "migrationControlCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_version", "command_id", "plan"],
      "properties": {
        "control_version": { "const": "cymule.virtual-region-migration-control/1" },
        "command_id": { "$ref": "#/$defs/nonEmpty" },
        "plan": { "$ref": "#/$defs/migrationPlan" }
      }
    },
    "terminalState": {
      "enum": ["succeeded", "failed", "cancelled"]
    },
    "archivedWorkIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_id", "region_id", "run_id", "max_epoch", "terminal_state"],
      "properties": {
        "work_id": { "$ref": "#/$defs/nonEmpty" },
        "region_id": { "$ref": "#/$defs/nonEmpty" },
        "run_id": { "$ref": "#/$defs/nonEmpty" },
        "max_epoch": { "type": "integer", "minimum": 1 },
        "terminal_state": { "$ref": "#/$defs/terminalState" }
      }
    },
    "compactedWorkIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_id", "region_id", "run_id", "max_epoch", "terminal_state", "certificate_id"
      ],
      "properties": {
        "work_id": { "$ref": "#/$defs/nonEmpty" },
        "region_id": { "$ref": "#/$defs/nonEmpty" },
        "run_id": { "$ref": "#/$defs/nonEmpty" },
        "max_epoch": { "type": "integer", "minimum": 1 },
        "terminal_state": { "$ref": "#/$defs/terminalState" },
        "certificate_id": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "archiveManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_version", "region_id", "run_id", "source_causal_cut",
        "occurrences", "work_index"
      ],
      "properties": {
        "manifest_version": { "const": "cymule.virtual-archive-manifest/1" },
        "region_id": { "$ref": "#/$defs/nonEmpty" },
        "run_id": { "$ref": "#/$defs/nonEmpty" },
        "source_causal_cut": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmpty" }
        },
        "occurrences": {
          "type": "object", "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/occurrence" }
        },
        "work_index": {
          "type": "object", "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/archivedWorkIndex" }
        }
      }
    },
    "completionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region_id", "run_id", "occurrence_count", "work_count", "succeeded_count",
        "failed_count", "cancelled_count", "output_digest", "evidence_digest",
        "retained_debug_index_digest"
      ],
      "properties": {
        "region_id": { "$ref": "#/$defs/nonEmpty" },
        "run_id": { "$ref": "#/$defs/nonEmpty" },
        "occurrence_count": { "type": "integer", "minimum": 1 },
        "work_count": { "type": "integer", "minimum": 1 },
        "succeeded_count": { "type": "integer", "minimum": 0 },
        "failed_count": { "type": "integer", "minimum": 0 },
        "cancelled_count": { "type": "integer", "minimum": 0 },
        "output_digest": { "$ref": "#/$defs/nonEmpty" },
        "evidence_digest": { "$ref": "#/$defs/nonEmpty" },
        "retained_debug_index_digest": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "replayAvailability": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["status"],
          "properties": { "status": { "const": "exact" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["status", "missing"],
          "properties": {
            "status": { "const": "projection_only" },
            "missing": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["status", "reason"],
          "properties": {
            "status": { "const": "unavailable" },
            "reason": { "$ref": "#/$defs/nonEmpty" }
          }
        }
      ]
    },
    "compactionCertificate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "certificate_version", "certificate_id", "source_causal_cut", "summary",
        "summary_state_digest", "unresolved_obligations", "retained_occurrence_bindings",
        "replay_availability", "rehydration_manifest", "compactor_binding", "compactor_revision"
      ],
      "properties": {
        "certificate_version": { "const": "cymule.virtual-compaction-certificate/1" },
        "certificate_id": { "$ref": "#/$defs/nonEmpty" },
        "source_causal_cut": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmpty" }
        },
        "summary": { "$ref": "#/$defs/completionSummary" },
        "summary_state_digest": { "$ref": "#/$defs/nonEmpty" },
        "unresolved_obligations": {
          "type": "array", "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmpty" }
        },
        "retained_occurrence_bindings": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmpty" }
        },
        "replay_availability": { "$ref": "#/$defs/replayAvailability" },
        "rehydration_manifest": { "$ref": "#/$defs/artifact" },
        "compactor_binding": { "$ref": "#/$defs/nonEmpty" },
        "compactor_revision": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "compactionControlCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_version", "command_id", "region_id", "source_causal_cut",
        "compactor_binding", "compactor_revision"
      ],
      "properties": {
        "control_version": { "const": "cymule.virtual-compaction-control/1" },
        "command_id": { "$ref": "#/$defs/nonEmpty" },
        "region_id": { "$ref": "#/$defs/nonEmpty" },
        "source_causal_cut": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmpty" }
        },
        "compactor_binding": { "$ref": "#/$defs/nonEmpty" },
        "compactor_revision": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "compactionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "certificate"],
      "properties": {
        "command": { "$ref": "#/$defs/compactionControlCommand" },
        "certificate": { "$ref": "#/$defs/compactionCertificate" }
      }
    },
    "rehydrationControlCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_version", "command_id", "certificate_id", "occurrence_ids"],
      "properties": {
        "control_version": { "const": "cymule.virtual-rehydration-control/1" },
        "command_id": { "$ref": "#/$defs/nonEmpty" },
        "certificate_id": { "$ref": "#/$defs/nonEmpty" },
        "occurrence_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmpty" }
        }
      }
    },
    "rehydrationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "restored_occurrence_ids"],
      "properties": {
        "command": { "$ref": "#/$defs/rehydrationControlCommand" },
        "restored_occurrence_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmpty" }
        }
      }
    },
    "claimControlCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_version", "command_id", "owner", "slot_id", "occurrence_binding",
        "capabilities", "logical_now", "lease_ttl"
      ],
      "properties": {
        "control_version": { "const": "cymule.virtual-claim-control/1" },
        "command_id": { "$ref": "#/$defs/nonEmpty" },
        "owner": { "$ref": "#/$defs/nonEmpty" },
        "slot_id": { "$ref": "#/$defs/nonEmpty" },
        "occurrence_binding": { "$ref": "#/$defs/nonEmpty" },
        "capabilities": {
          "type": "array", "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmpty" }
        },
        "logical_now": { "type": "integer", "minimum": 0 },
        "lease_ttl": { "type": "integer", "minimum": 1 }
      }
    },
    "claimReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "claim"],
      "properties": {
        "command": { "$ref": "#/$defs/claimControlCommand" },
        "claim": { "oneOf": [{ "$ref": "#/$defs/claim" }, { "type": "null" }] }
      }
    },
    "leaseRenewalControlCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_version", "command_id", "work_id", "owner", "epoch",
        "expected_lease_epoch", "logical_now", "lease_ttl"
      ],
      "properties": {
        "control_version": { "const": "cymule.virtual-lease-renewal-control/1" },
        "command_id": { "$ref": "#/$defs/nonEmpty" },
        "work_id": { "$ref": "#/$defs/nonEmpty" },
        "owner": { "$ref": "#/$defs/nonEmpty" },
        "epoch": { "type": "integer", "minimum": 1 },
        "expected_lease_epoch": { "type": "integer", "minimum": 1 },
        "logical_now": { "type": "integer", "minimum": 0 },
        "lease_ttl": { "type": "integer", "minimum": 1 }
      }
    },
    "leaseRenewalReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "lease"],
      "properties": {
        "command": { "$ref": "#/$defs/leaseRenewalControlCommand" },
        "lease": { "$ref": "#/$defs/claimLease" }
      }
    },
    "recoveryControlCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_version", "command_id", "work_id", "expected_owner",
        "expected_epoch", "expected_lease_epoch", "observed_at", "resolution"
      ],
      "properties": {
        "control_version": { "const": "cymule.virtual-recovery-control/1" },
        "command_id": { "$ref": "#/$defs/nonEmpty" },
        "work_id": { "$ref": "#/$defs/nonEmpty" },
        "expected_owner": { "$ref": "#/$defs/nonEmpty" },
        "expected_epoch": { "type": "integer", "minimum": 1 },
        "expected_lease_epoch": { "type": "integer", "minimum": 1 },
        "observed_at": { "type": "integer", "minimum": 0 },
        "resolution": { "$ref": "#/$defs/resolution" }
      }
    },
    "recoveryReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "occurrence"],
      "properties": {
        "command": { "$ref": "#/$defs/recoveryControlCommand" },
        "occurrence": { "$ref": "#/$defs/occurrence" }
      }
    },
    "runWeightControlCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_version", "command_id", "run_id", "weight"],
      "properties": {
        "control_version": { "const": "cymule.virtual-run-weight-control/1" },
        "command_id": { "$ref": "#/$defs/nonEmpty" },
        "run_id": { "$ref": "#/$defs/nonEmpty" },
        "weight": { "type": "integer", "minimum": 1 }
      }
    },
    "runWeightReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "previous_weight", "current_weight"],
      "properties": {
        "command": { "$ref": "#/$defs/runWeightControlCommand" },
        "previous_weight": { "type": "integer", "minimum": 1 },
        "current_weight": { "type": "integer", "minimum": 1 }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheduling_policy", "regions", "ready", "active", "parked", "known", "last_run",
        "last_region",
        "claim_epochs", "occurrences", "run_weights", "run_deficits", "dispatch_sequence",
        "ready_since", "retired_regions", "migrations", "compactions",
        "compaction_receipts", "compacted_work", "compacted_regions",
        "rehydration_receipts", "claim_receipts", "lease_renewal_receipts",
        "recovery_receipts", "run_weight_receipts"
      ],
      "properties": {
        "scheduling_policy": { "$ref": "#/$defs/schedulingPolicy" },
        "regions": { "type": "object", "additionalProperties": { "$ref": "#/$defs/region" } },
        "ready": {
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/work" } }
        },
        "active": { "type": "object", "additionalProperties": { "$ref": "#/$defs/claim" } },
        "parked": { "type": "object", "additionalProperties": { "$ref": "#/$defs/parked" } },
        "known": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
        "last_run": { "oneOf": [{ "$ref": "#/$defs/nonEmpty" }, { "type": "null" }] },
        "last_region": { "oneOf": [{ "$ref": "#/$defs/nonEmpty" }, { "type": "null" }] },
        "claim_epochs": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 1 }
        },
        "occurrences": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/occurrence" }
        },
        "run_weights": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 1 }
        },
        "run_deficits": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "dispatch_sequence": { "type": "integer", "minimum": 0 },
        "ready_since": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "retired_regions": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/nonEmpty" }
        },
        "migrations": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/migrationReceipt" }
        },
        "compactions": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/compactionCertificate" }
        },
        "compaction_receipts": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/compactionReceipt" }
        },
        "compacted_work": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/compactedWorkIndex" }
        },
        "compacted_regions": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/nonEmpty" }
        },
        "rehydration_receipts": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/rehydrationReceipt" }
        },
        "claim_receipts": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/claimReceipt" }
        },
        "lease_renewal_receipts": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/leaseRenewalReceipt" }
        },
        "recovery_receipts": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/recoveryReceipt" }
        },
        "run_weight_receipts": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/runWeightReceipt" }
        }
      }
    }
  }
}
