{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cymule.dev/schemas/artifact-type-contract.schema.json",
  "title": "Cymule Artifact Type Contract cymule.artifact-type-contract/1",
  "oneOf": [
    { "$ref": "#/$defs/candidate" },
    { "$ref": "#/$defs/contract" }
  ],
  "$defs": {
    "schema": {
      "description": "Rust admission bounds the complete schema Value before cloning, hashing, or compiling: at most 1048576 encoded bytes, 16384 JSON value nodes, and depth 64 with the root at depth one. Local schema references must resolve without cycles; expanded traversal admits at most depth 64, 65536 schema visits, and 16777216 cumulative canonical subschema bytes, counting each repeated reference. These aggregate semantic budgets are not expressible by JSON Schema shape validation alone.",
      "oneOf": [{ "type": "boolean" }, { "type": "object" }]
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z0-9._+-]+(?:/[a-z0-9._+-]+)+$",
      "maxLength": 255
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "artifact_kind", "media_type", "schema"],
      "properties": {
        "contract_version": { "const": "cymule.artifact-type-contract/1" },
        "artifact_kind": { "$ref": "#/$defs/kind" },
        "media_type": { "const": "application/json" },
        "schema": { "$ref": "#/$defs/schema" }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "contract_version",
        "artifact_kind",
        "media_type",
        "schema_digest",
        "schema"
      ],
      "properties": {
        "contract_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "contract_version": { "const": "cymule.artifact-type-contract/1" },
        "artifact_kind": { "$ref": "#/$defs/kind" },
        "media_type": { "const": "application/json" },
        "schema_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "schema": { "$ref": "#/$defs/schema" }
      }
    }
  }
}
