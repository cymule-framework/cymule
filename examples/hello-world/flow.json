{
  "ir_version": "cymule.ir/3",
  "name": "hello_world",
  "entry": "main",
  "components": [
    {
      "id": "example.greet",
      "input_schema": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string" } }
      },
      "output_schema": {
        "type": "object",
        "required": ["message"],
        "properties": { "message": { "type": "string" } }
      },
      "output_artifact_kind": "cymule.component-output/1",
      "requirements": {}
    }
  ],
  "effects": [
    {
      "id": "example.capture",
      "input_schema": {
        "type": "object",
        "required": ["message"],
        "properties": { "message": { "type": "string" } }
      },
      "output_schema": {},
      "profile": {
        "mutation": "mutating",
        "dispatch": "on_scope_commit",
        "reconciliation": "queryable",
        "keyed_idempotency": true,
        "irreversible": false
      },
      "requirements": {}
    }
  ],
  "definitions": [
    {
      "id": "main",
      "input_schema": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string" } }
      },
      "output_schema": {
        "type": "object",
        "required": ["message"],
        "properties": { "message": { "type": "string" } }
      },
      "body": {
        "steps": [
          {
            "id": "call.greet",
